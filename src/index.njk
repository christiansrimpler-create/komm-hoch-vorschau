---
layout: base.njk
permalink: /
mitFormular: true
bodyClass: "seite-start"
---
{% set i = inhalte %}

<section class="hero">
  <div class="hero__dachflaeche" aria-hidden="true">
    <div class="dach">
      {%- for reihe in range(0, 9) -%}
        {%- for spalte in range(0, 18) -%}
          <i style="--i:{{ reihe * 18 + spalte }};--r:{{ reihe }};--c:{{ spalte }}"></i>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
  <div class="wrap hero__raster">
    <div class="hero__text">
      <p class="hero__dach">{{ i.hero.dachzeile }}</p>
      <h1 class="hero__titel"><span class="zeile"><span>Dachdecker werden.</span></span><span class="zeile"><em>Wir finden dir den&nbsp;Betrieb.</em></span></h1>
      <p class="hero__lauf">{{ i.hero.text }}</p>
      <div class="sticker-wand" aria-label="Kurz gesagt">
        <span class="sticker sticker--rot" style="--neig:-4deg">1.050 € im 1. Jahr</span>
        <span class="sticker" style="--neig:3deg">Betrieb in deiner Nähe</span>
        <span class="sticker sticker--hell" style="--neig:-2deg">0 € Infopaket</span>
        <span class="sticker" style="--neig:5deg">Meldung in 48 h</span>
      </div>
    </div>
    <div class="hero__formular">
      {% set fid = 'a' %}{% include "formular.njk" %}
    </div>
  </div>
</section>

<div class="laufband" aria-hidden="true">
  <div class="laufband__spur">
    {% set themen = ["Photovoltaik", "Schiefer", "Gründach", "Drohnenvermessung", "Flachdach", "Zink und Kupfer", "Fassade", "Denkmalschutz", "Dämmung", "Reet"] %}
    {% for n in range(0, 2) %}{% for t in themen %}<span>{{ t }}</span>{% endfor %}{% endfor %}
  </div>
</div>

<section class="verdienst" aria-labelledby="verdienst-titel">
  <div class="wrap">
    <h2 id="verdienst-titel" class="titel">Dein Lohn geht die Schräge hoch.</h2>
    <p class="verdienst__text">Tarifvergütung Dachdeckerhandwerk, brutto pro Monat, Stand Oktober 2026. Jedes Jahr eine Reihe höher.</p>

    <div class="schraege" data-schraege aria-label="Ausbildungsvergütung nach Lehrjahr, danach Geselle und Meister">
      <svg class="schraege__svg" viewBox="0 0 800 420" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <pattern id="latten" width="40" height="40" patternUnits="userSpaceOnUse" patternTransform="rotate(-27.25)">
            <rect width="40" height="6" fill="rgba(255,255,255,0.07)"/>
          </pattern>
          <path id="ziegel" d="M-15,-24 h30 v16 a15,10 0 0 1 -30,0 z"/>
        </defs>
        {# Haus: Pultdach, Wände, Tür, Fenster, Schornstein #}
        <g class="haus">
          <polygon points="40,380 700,40 700,380" fill="url(#latten)" class="schraege__flaeche"/>
          <polyline points="40,380 40,300" vector-effect="non-scaling-stroke"/>
          <polyline points="700,380 700,40" vector-effect="non-scaling-stroke"/>
          <rect x="560" y="305" width="44" height="75" vector-effect="non-scaling-stroke"/>
          <rect x="430" y="240" width="48" height="44" vector-effect="non-scaling-stroke"/>
          <polyline points="430,262 478,262 454,240 454,284" vector-effect="non-scaling-stroke" opacity="0.5"/>
          <rect class="schornstein" x="636" y="8" width="30" height="70" vector-effect="non-scaling-stroke"/>
          <rect class="schornstein" x="630" y="2" width="42" height="10" vector-effect="non-scaling-stroke"/>
        </g>
        <polyline class="schraege__boden" points="0,380 800,380" vector-effect="non-scaling-stroke"/>
        <polyline class="schraege__dach" pathLength="1" points="40,380 700,40" vector-effect="non-scaling-stroke"/>
        {# Ziegelreihe entlang der Schräge, wird von unten nach oben gedeckt #}
        <g class="ziegelreihe">
          {%- for k in range(0, 23) -%}
            {%- set t = (k + 0.5) / 23 -%}
            <use href="#ziegel" style="--k:{{ k }}" transform="translate({{ (40 + 660 * t) | round(1) }} {{ (380 - 340 * t) | round(1) }}) rotate(-27.25)"/>
          {%- endfor -%}
        </g>
      </svg>
      <div class="marke" style="--x:19.85%;--y:75.9%;--d:0.55s"><i class="punkt"></i><div class="marke__box"><strong data-zahl="1050">1.050 €</strong><span>1. Lehrjahr</span></div></div>
      <div class="marke" style="--x:38%;--y:58.1%;--d:0.8s"><i class="punkt"></i><div class="marke__box"><strong data-zahl="1200">1.200 €</strong><span>2. Lehrjahr</span></div></div>
      <div class="marke" style="--x:56.15%;--y:40.3%;--d:1.05s"><i class="punkt"></i><div class="marke__box"><strong data-zahl="1460">1.460 €</strong><span>3. Lehrjahr</span></div></div>
      <div class="marke marke--still" style="--x:72.65%;--y:24.1%;--d:1.3s"><i class="punkt"></i><div class="marke__box"><strong>Geselle</strong><span>Tariflohn, volle Stelle</span></div></div>
      <div class="marke marke--first" style="--x:87.5%;--y:9.5%;--d:1.55s"><i class="punkt punkt--first"></i><div class="marke__box"><strong>Meister</strong><span>eigener Betrieb oder Bauleitung</span></div></div>
    </div>

    <p class="verdienst__fuss"><span class="sticker sticker--hell" style="--neig:-3deg">+ 410 € in drei Jahren</span> Die Meisterschule ist direkt in Eslohe.</p>
  </div>
</section>

<section class="nichtdas" aria-labelledby="nichtdas-titel">
  <div class="wrap">
    <h2 id="nichtdas-titel" class="sr-only">Was du nicht machen musst</h2>
    <p class="streich"><span>Bürojob.</span></p>
    <p class="streich"><span>Warteschleife an der Uni.</span></p>
    <p class="streich"><span>Praktikum für lau.</span></p>
    <p class="streich"><span>Noch ein Jahr Schule.</span></p>
    <p class="dasda">Dachdecker.</p>
  </div>
</section>

<section class="gruende" aria-labelledby="gruende-titel">
  <div class="wrap">
    <h2 id="gruende-titel" class="titel">{{ i.gruende.titel }}</h2>
    <div class="gruende__liste">
      {% set farben = ["grund--ziegel", "grund--hell", "grund--gelb", "grund--schiefer"] %}
      {% for g in i.gruende.liste %}
      <div class="grund {{ farben[loop.index0] }}" style="--neig:{{ ['-1.2deg','0.8deg','-0.6deg','1.1deg'][loop.index0] }}">
        <span class="grund__nr">{{ loop.index }}/4</span>
        <h3>{{ g.titel }}</h3>
        <p>{{ g.text }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="reel" aria-labelledby="reel-titel">
  <div class="wrap reel__raster">
    <div class="reel__text">
      <h2 id="reel-titel" class="titel">Ein Tag auf dem Dach</h2>
      <p>Kein Büro, kein Hörsaal. Früh raus, früh fertig, und abends steht da etwas, das du gemacht hast.</p>
      <p class="todo">TODO: Slides durch Handyvideos vom Dreh ersetzen (9:16, ohne Ton, 4 bis 6 Sekunden)</p>
      <a class="knopf" href="#formular">Infopaket holen</a>
    </div>
    <div class="handy" data-reel>
      <div class="handy__balken" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      <div class="handy__slides">
        <figure class="slide slide--1 aktiv"><figcaption><strong>06:45. Baustelle. Kaffee.</strong><span>Früh raus. Dafür um 16 Uhr fertig.</span></figcaption></figure>
        <figure class="slide slide--2"><figcaption><strong>Heute: 140 m² Schiefer.</strong><span>Du siehst am Abend, was du gemacht hast.</span></figcaption></figure>
        <figure class="slide slide--3"><figcaption><strong>Lohn ist da. 1.050 €.</strong><span>Tarif. Kein Taschengeld.</span></figcaption></figure>
        <figure class="slide slide--4"><figcaption><strong>Blockwoche in Eslohe.</strong><span>Fünf Wochen mit Azubis aus ganz Westfalen. Wohnheim inklusive.</span></figcaption></figure>
        <figure class="slide slide--5"><figcaption><strong>Bock?</strong><span>Infopaket holen, wir finden dir den Betrieb.</span><a class="knopf knopf--klein" href="#formular">Los</a></figcaption></figure>
      </div>
      <button class="handy__tipp handy__tipp--links" type="button" aria-label="Zurück"></button>
      <button class="handy__tipp handy__tipp--rechts" type="button" aria-label="Weiter"></button>
    </div>
  </div>
</section>

<section class="ablauf" aria-labelledby="ablauf-titel">
  <div class="wrap ablauf__raster">
    <div>
      <h2 id="ablauf-titel" class="titel">So läuft das Nachfassen.<br>Echt jetzt.</h2>
      <ol class="schritte schritte--eng">
        {% for s in i.ablauf.schritte %}
        <li class="schritt"><h3>{{ s.titel }}</h3><p>{{ s.text }}</p></li>
        {% endfor %}
      </ol>
    </div>
    <div class="chat" data-chat aria-label="Beispiel-Chat">
      <div class="chat__kopf"><span class="chat__avatar"></span><span><strong>Jan, Dachdeckerhandwerk Westfalen</strong><br><small>online</small></span></div>
      <div class="chat__verlauf">
        <p class="blase blase--sie">Hey Leon, hier ist Jan vom Dachdeckerhandwerk Westfalen. Du hast dir das Infopaket geholt. Schon reingeschaut?</p>
        <p class="blase blase--ich">ja, klingt gut. hab aber noch keinen betrieb</p>
        <p class="blase blase--sie">Dafür bin ich da. PLZ 59872, richtig? Ich hab drei Innungsbetriebe bei dir, die ab Sommer ausbilden.</p>
        <p class="blase blase--ich">nice. wie läuft das ab?</p>
        <p class="blase blase--sie">Ich stell den Kontakt her, du machst zwei, drei Tage Probearbeiten. Wenn's passt: Vertrag. Wann hast du Zeit zum Telefonieren?</p>
        <p class="blase blase--ich">morgen nach der schule?</p>
        <p class="blase blase--sie">Passt. 14 Uhr. Bis morgen.</p>
      </div>
      <p class="chat__hinweis">Beispiel. Namen erfunden, Ablauf echt.</p>
    </div>
  </div>
</section>

<section class="schule" aria-labelledby="schule-titel">
  <div class="wrap">
    <h2 id="schule-titel" class="titel schule__titel">Eslohe.<br><span>Berufsschule, Werkhalle, Wohnheim. Alles auf einem Berg.</span></h2>
    <div class="schule__raster">
      <div class="polaroid" style="--neig:-3deg">
        <figure class="bild bild--polaroid"><figcaption>Foto: Werkhalle oder Wohnheim</figcaption></figure>
        <p class="polaroid__text">Lorenz-Burmann-Schule, Sauerland</p>
        <i class="tape"></i>
      </div>
      <div class="schule__text">
        <p>{{ i.schule.text }}</p>
        <dl class="zahlen">
          <div><dt>2 × 5</dt><dd>Wochen Block pro Jahr</dd></div>
          <div><dt>320</dt><dd>Betten im Wohnheim</dd></div>
          <div><dt>0 km</dt><dd>bis zur Meisterschule</dd></div>
        </dl>
        <ul class="haken haken--hell">
          {% for p in i.schule.punkte %}<li>{{ p }}</li>{% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="stimmen" aria-labelledby="stimmen-titel">
  <div class="wrap">
    <h2 id="stimmen-titel" class="titel">{{ i.stimmen.titel }}</h2>
    <p class="todo">{{ i.stimmen.hinweis }}</p>
    <div class="stimmen__liste">
      {% for s in i.stimmen.liste %}
      <figure class="kommentar" style="--neig:{{ ['-2deg','1.5deg','-1deg'][loop.index0] }}">
        <div class="kommentar__kopf"><i class="kommentar__avatar" style="--a:{{ ['#c4371f','#2b3440','#8c98a4'][loop.index0] }}"></i><span><strong>{{ s.name }}</strong><br><small>{{ s.rolle }}</small></span></div>
        <blockquote>{{ s.zitat }}</blockquote>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>

<section class="eltern" id="eltern" aria-labelledby="eltern-titel">
  <div class="wrap">
    <h2 id="eltern-titel" class="titel">{{ i.eltern.titel }}</h2>
    <p class="eltern__einleitung">{{ i.eltern.text }}</p>
    <dl class="eltern__liste">
      {% for p in i.eltern.punkte %}
      <div><dt>{{ p.titel }}</dt><dd>{{ p.text | safe }}</dd></div>
      {% endfor %}
    </dl>
    <p>Sie können das Infopaket auch an Ihre eigene E-Mail-Adresse anfordern. <a href="#formular">Zum Formular</a>, bei „Ich frage an als“ einfach „Elternteil“ wählen.</p>
  </div>
</section>

<section class="faq" id="faq" aria-labelledby="faq-titel">
  <div class="wrap">
    <h2 id="faq-titel" class="titel">{{ i.faq.titel }}</h2>
    <div class="faq__liste">
      {% for q in i.faq.liste %}
      <details class="frage">
        <summary>{{ q.frage }}</summary>
        <p>{{ q.antwort }}</p>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

<section class="abschluss" aria-labelledby="abschluss-titel">
  <div class="wrap abschluss__raster">
    <div>
      <h2 id="abschluss-titel" class="titel abschluss__titel">Bock?</h2>
      <p class="abschluss__text">{{ i.abschluss.text }}</p>
      <div class="sticker-wand"><span class="sticker" style="--neig:-3deg">1 Minute</span><span class="sticker sticker--hell" style="--neig:2deg">0 €</span><span class="sticker" style="--neig:-1deg">Kein Spam</span></div>
    </div>
    <div class="abschluss__formular">
      {% set fid = 'b' %}{% include "formular.njk" %}
    </div>
  </div>
</section>
