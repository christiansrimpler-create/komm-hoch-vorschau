<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ titel or site.claim }} – {{ site.name }}</title>
  <meta name="description" content="{{ beschreibung or site.beschreibung }}">
  {% if not erlaubeIndexierung or noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <meta property="og:title" content="{{ titel or site.claim }}">
  <meta property="og:description" content="{{ beschreibung or site.beschreibung }}">
  <meta property="og:type" content="website">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@700;800&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}?v={{ assetVersion }}">
  <link rel="icon" href="{{ '/assets/img/favicon.svg' | url }}?v=3" type="image/svg+xml">
  <link rel="icon" href="{{ '/assets/img/favicon-32.png' | url }}?v=3" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="{{ '/assets/img/apple-touch-icon.png' | url }}">
</head>
<body class="{{ bodyClass }}">
  <a class="skip" href="#inhalt">Zum Inhalt</a>
  <div class="seitenfortschritt" aria-hidden="true"></div>
  <header class="kopf">
    <div class="wrap kopf__zeile">
      <a class="marke" href="{{ '/' | url }}" aria-label="{{ site.name }}, Startseite">
        <img class="marke__logo" src="{{ '/assets/img/komm-hoch-logo.png' | url }}" alt="KOMM HOCH! Werde Dachdecker:in" width="783" height="348">
      </a>
      <nav class="kopf__nav" aria-label="Seitennavigation">
        <a href="#eltern">Für Eltern</a>
        <a href="#faq">Fragen</a>
        <a class="knopf knopf--klein" href="#formular">Infopaket</a>
      </nav>
    </div>
  </header>

  <main id="inhalt">
    {{ content | safe }}
  </main>

  <footer class="fuss">
    <div class="wrap fuss__raster">
      <div>
        <p class="fuss__name">{{ site.absender.name }}</p>
        <p>{{ site.absender.strasse }}, {{ site.absender.ort }}<br>
        <a href="tel:{{ site.absender.telefon | replace(' ', '') }}">{{ site.absender.telefon }}</a> · <a href="mailto:{{ site.absender.email }}">{{ site.absender.email }}</a></p>
        <p>Ein Angebot des {{ site.absender.traeger }}.</p>
      </div>
      <nav aria-label="Rechtliches" class="fuss__nav">
        <a href="{{ '/impressum/' | url }}">Impressum</a>
        <a href="{{ '/datenschutz/' | url }}">Datenschutz</a>
        <a href="{{ site.absender.web }}" rel="noopener">dachdeckerschule.de</a>
      </nav>
    </div>
  </footer>

  {% if mitFormular %}
  <div class="mobil-cta" aria-hidden="true">
    <a class="knopf knopf--voll" href="#formular">Infopaket anfordern</a>
  </div>
  <script src="{{ '/assets/js/form.js' | url }}?v={{ assetVersion }}" defer></script>
  {% endif %}
</body>
</html>
